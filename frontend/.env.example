
# ─── TRINETRA Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.

# Backend API base URL — points to the FastAPI prediction service.
# Default: http://localhost:8001
VITE_BACKEND_URL=http://localhost:8001

# Gemini API key for AI Copilot feature (optional for offline use)
VITE_GEMINI_API_KEY=
